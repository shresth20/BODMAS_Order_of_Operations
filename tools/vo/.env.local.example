# Copy to tools/vo/.env.local and fill in. That file is gitignored — never commit a key.
#
# A service-account key scoped to text_to_speech only is enough, e.g.
#   curl -X POST https://api.elevenlabs.io/v1/service-accounts/<service_account_user_id>/api-keys \
#        -H "xi-api-key: $ELEVENLABS_ADMIN_KEY" \
#        -H "Content-Type: application/json" \
#        -d '{"name":"mt06a01-vo-generator","permissions":["text_to_speech"]}'
#
# Such a key CANNOT list voices, so set ELEVENLABS_VOICE_ID explicitly rather
# than relying on --voice-name lookup.

ELEVENLABS_API_KEY=

# ElevenLabs → Voices → "Mitali - Kids Mythology Storyteller" → copy voice ID.
# Add it from the Voice Library to your account first, or this ID will 404.
ELEVENLABS_VOICE_ID=
